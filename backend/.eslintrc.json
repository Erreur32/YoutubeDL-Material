{
    "env": {
        "node": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:security/recommended"
    ],
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
    },
    "plugins": [
        "security"
    ],
    "rules": {
        "no-unused-vars": "warn",
        "no-async-promise-executor": "warn"
    },
    "root": true
}
